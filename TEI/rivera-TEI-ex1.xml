<TEI xmlns="http://www.tei-c.org/ns/1.0">

   <teiHeader>
      <fileDesc>
         <titleStmt>
            <title>Mary Behrend's Letters</title>
            <author>Mary Behrend</author>
            <respStmt>
               <resp>Encoded by</resp>
               <name>Kaa Rivera</name>
            </respStmt>
         </titleStmt>
         <publicationStmt>
            <publisher>Friendship Calendar Co.</publisher>
            <date>1908</date>
            <availability>
               <p>Freely available at the Penn State Behrend Library</p>
            </availability>
         </publicationStmt>
         <sourceDesc>
            <p>Physical calendar pages</p>
            <p>A collection of handwritten letters and drawings from Mary "Molly" Behrend to her
               husband, Ernest Behrend.</p>
         </sourceDesc>
      </fileDesc>
   </teiHeader>
   <text>
      <body>
         <div type="calendar" n="1">
            <dateline><emph rend = "blue-color">M</emph>arch 11, 1909</dateline>
            <figure place = "center">
               <figDesc>Four drawings of elegantly dressed women in brightly colored dresses point at each other,
                  presumably in the midst of a teaparty.</figDesc>
            </figure>
            <fw type = "hand" place = "bottom-center">Everybody dressed in their best, for <emph rend="b">this</emph> is an <emph rend="b"
                  >Erie</emph>
               <emph rend="b">Tea</emph>. They <emph rend="b">eat</emph> too much, <emph rend="b"
                  >talk</emph> too much. You can bet they drink <unclear reason="illegible">rope in</unclear> me</fw>
            <!--Unsure of how to add the xml ids...-->
            <fw rend = "red-ink"></fw>
         </div>
         <div type="calendar" n="2">
            <dateline><emph rend = "red-color">M</emph>arch 12, 1909</dateline>
            <figure place="center">
               <figDesc>A drawing of Molly "Mary" wearing large snow shoes.</figDesc>
            </figure>
            <fw type ="hand" place="right-center">Molly on snowshoes that Mr. Weir got. Pretty picture is it not?!</fw>
            <fw rend = "#red-ink" place = "bottom-right" type = "hand"><unclear reason = "illegible" >Love you Molly.</unclear></fw>
         </div>
      </body>
   </text>
</TEI>
